{
    "name": "smart-cnc-control",
    "version": "0.1.0",
    "description": "Smart CNC Control Application with GRBL support",
    "main": "main.js",
    "scripts": {
      "start": "electron .",
      "dev": "concurrently \"npm run start-backend\" \"electron .\"",
      "start-backend": "cd backend && python main.py",
      "build": "electron-builder",
      "test": "jest"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
      "concurrently": "^8.2.2",
      "electron": "^28.1.0",
      "electron-builder": "^24.9.1",
      "electron-devtools-installer": "^3.2.0"
    },
    "dependencies": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "socket.io-client": "^4.7.2",
      "three": "^0.159.0",
      "monaco-editor": "^0.44.0",
      "@monaco-editor/react": "^4.6.0"
    },
    "build": {
      "appId": "com.yourname.smart-cnc-control",
      "productName": "Smart CNC Control",
      "directories": {
        "output": "dist"
      },
      "win": {
        "target": [
          "nsis"
        ],
        "icon": "frontend/public/icon.ico"
      }
    }
  }